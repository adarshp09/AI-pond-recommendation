# ============================================================
# AI Pond Recommendation - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# OpenTopography API (required for DEM fetch)
OPENTOPOGRAPHY_API_KEY=
OPENTOPOGRAPHY_DATASET=SRTMGL1
OPENTOPOGRAPHY_URL=https://portal.opentopography.org/API/globaldem

# Open-Meteo Historical Weather API
OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# OSM Overpass API (for land context: water bodies, roads, buildings)
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
OVERPASS_TIMEOUT_SECONDS=25.0
OVERPASS_RETRIES=2

# Nominatim / Photon (geocoding and place search)
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
PHOTON_URL=https://photon.komoot.io/api/

# HTTP Client
HTTP_TIMEOUT_SECONDS=30.0
HTTP_RETRY_COUNT=3

# Cache
CACHE_DIR=.cache
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true
ENABLE_RETRIES=true

# DEM / Terrain
DEM_RESOLUTION_M=5.0

# Upload
MAX_UPLOAD_SIZE_MB=100

# Logging
LOG_LEVEL=INFO