# ============================================================
# AI Pond Recommendation - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# ============================================================

# OpenTopography API (required for DEM fetch)
OPENTOPOGRAPHY_API_KEY=
OPENTOPOGRAPHY_DATASET=SRTMGL1
OPENTOPOGRAPHY_URL=https://portal.opentopography.org/API/globaldem

# Open-Meteo Historical Weather API
OPENMETEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive

# OSM Overpass API (for land context: water bodies, roads, buildings)
OVERPASS_URL=https://overpass-api.de/api/interpreter
OVERPASS_FALLBACK_URL=https://overpass.kumi.systems/api/interpreter
OVERPASS_TIMEOUT_SECONDS=25.0
OVERPASS_RETRIES=2

# Local land provider (Phase 03). Prepared by scripts/prepare_osm_data.py.
# Runtime enrichment is served from the local GeoPackage only; Overpass is NOT
# queried at runtime. LAND_PROVIDER_MODE: local_first | local_only | overpass_only
# (overpass_only is for explicit offline tools only.)
LOCAL_OSM_ENABLED=true
LAND_PROVIDER_MODE=local_only
LOCAL_OSM_GPKG_PATH=data/osm/prepared/land_context.gpkg
LOCAL_OSM_MANIFEST_PATH=data/osm/manifest.json
LOCAL_OSM_MAX_AGE_DAYS=180
LOCAL_OSM_QUERY_BUFFER_M=0
OVERPASS_FALLBACK_ENABLED=false

# Nominatim / Photon (geocoding and place search)
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
PHOTON_URL=https://photon.komoot.io/api/

# HTTP Client
HTTP_TIMEOUT_SECONDS=30.0
HTTP_RETRY_COUNT=3

# Cache
CACHE_DIR=.cache
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true
ENABLE_RETRIES=true

# Phase 04 — layered caching TTLs (seconds) and provider resilience
OPENTOPOGRAPHY_CACHE_TTL_S=2592000
RAINFALL_CACHE_TTL_S=2592000
RAINFALL_RETRIES=2
GEOCODING_CACHE_TTL_S=604800
GEOCODING_RETRIES=2
GEOCODING_MIN_INTERVAL_S=1.0
PLACE_SEARCH_CACHE_TTL_S=604800
PLACE_SEARCH_RETRIES=2
LOCAL_OSM_CACHE_TTL_S=3600
# Optional: token required by POST /cache/clear (empty = open in dev)
CACHE_ADMIN_TOKEN=

# ------------------------------------------------------------
# Running natively (no Docker), e.g. on sys1
# ------------------------------------------------------------
# This project has NO database and NO Redis/queue: the only state is the disk
# cache (CACHE_DIR) and the local GeoPackage. There are therefore no "db:5432"
# / "redis:6379" style URLs to remap. The single container service name in the
# repo is the Jaeger OTLP endpoint (docker-compose.yml uses http://jaeger:4318);
# natively use localhost (below) or leave OTEL_ENABLED=false when no collector
# runs. config.py rewrites known compose service hosts to localhost whenever it
# is NOT running inside a container.
# Container-only paths (/app/...) are remapped to the repo root by
# scripts/setup_sys1.sh when it starts the server natively.

# Phase 08 — OpenTelemetry tracing (off by default) + Prometheus metrics
# Set OTEL_ENABLED=true only when an OTLP collector is reachable (e.g. Jaeger).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-pond-recommendation
# OTLP/HTTP base endpoint; the exporter posts to <endpoint>/v1/traces.
# Compose overrides this with http://jaeger:4318 (auto-rewritten to localhost
# natively). Prometheus metrics on /metrics work without a collector.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_METRICS_ENABLED=true

# Phase 09 — river/waterway exclusion (safety buffer around water bodies/streams)
RIVER_EXCLUSION_ENABLED=true
WATERBODY_BUFFER_METERS=30.0

# Phase 02 — opt-in recommendation engine. Default false keeps the legacy
# pipeline. Set to 1 to route /analyzeContour and /analyzeLocation through
# backend.pipeline (candidates -> geographic context -> rainfall/runoff ->
# recommendation engine).
POND_RECOMMENDATION_ENGINE=false

# DEM / Terrain
DEM_RESOLUTION_M=5.0

# Upload
MAX_UPLOAD_SIZE_MB=100

# Logging
LOG_LEVEL=INFO
# Phase 05 — "text" for local dev, "json" for production structured logs.
LOG_FORMAT=text